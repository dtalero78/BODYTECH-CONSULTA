# Server Configuration
PORT=3000
NODE_ENV=development

# Twilio Video Credentials (for video calls)
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here

# Twilio API Key (required for Twilio Video)
TWILIO_API_KEY_SID=your_api_key_sid_here
TWILIO_API_KEY_SECRET=your_api_key_secret_here

# Twilio Voice Credentials (for phone calls)
TWILIO_VOICE_ACCOUNT_SID=your_voice_account_sid_here
TWILIO_VOICE_AUTH_TOKEN=your_voice_auth_token_here

# WhatsApp API (WHAPI) - Required for session reports
WHAPI_TOKEN=your_whapi_token_here

# Twilio WhatsApp — remitente + plantillas de contenido aprobadas (HX...)
TWILIO_WHATSAPP_FROM=whatsapp:+5716284820
# Informe de Gestión diario a administradores (imagen del tablero por coach).
# Plantilla twilio/media aprobada: {{1}} = URL de la imagen · {{2}} = fecha·sede.
# Sin este SID el worker diario NO envía nada (no-op).
TWILIO_WHATSAPP_GESTION_TEMPLATE_SID=
# Hora Colombia (HH:MM) del envío diario del informe. Default 19:30.
GESTION_REPORT_HORA=19:30
# Base pública absoluta para la URL de la imagen del informe (Twilio la debe
# poder alcanzar). Default https://bodytech.app.
PUBLIC_BASE_URL=https://bodytech.app

# JWT Secret for application authentication
JWT_SECRET=your_jwt_secret_here

# CORS Settings
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# PostgreSQL Database (Digital Ocean) - Para backup y consultas rápidas
POSTGRES_USER=your_postgres_user_here
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_HOST=your_postgres_host_here
POSTGRES_PORT=25060
POSTGRES_DATABASE=defaultdb

# Integración Trepsi (B2B). API Key que Trepsi envía como
# `Authorization: Bearer <TREPSI_API_KEY>` cuando llama a
# /api/v1/integrations/trepsi/*. Generar 32+ bytes aleatorios:
#   openssl rand -hex 32
# Sin esta variable, los endpoints responden 503.
TREPSI_API_KEY=

# Integración mybodytech (B2B) — OAuth2 client_credentials (mismo esquema que
# el Validador RIPS de Bodytech). mybodytech pide un access_token en
# POST /api/v1/integrations/mybodytech/oauth/token enviando estas credenciales,
# y luego lo usa como `Authorization: Bearer <token>` en el resto.
# Generar: client_id → openssl rand -hex 8 ; client_secret → openssl rand -hex 32
# Sin estas variables, los endpoints responden 503.
MYBODYTECH_CLIENT_ID=
MYBODYTECH_CLIENT_SECRET=
# REQUERIDO: secreto para firmar los access_token (HS256). Debe ser DISTINTO del
# client_secret y no se comparte con mybodytech. Sin él, los endpoints dan 503.
#   openssl rand -hex 32
MYBODYTECH_TOKEN_SECRET=

# Integración mybodytech — Fase 2 (SALIDA): envío del RIPS a SU validador cuando
# el profesional cierra la historia. Son credenciales/URLs que mybodytech nos da
# (distintas a las de arriba). Sin ellas, no se envía nada (no rompe la HC).
MYBODYTECH_RIPS_OAUTH_URL=https://pre-oauth-pub.mybodytech.co/oauth/token
MYBODYTECH_RIPS_API_URL=https://pre-apirips-pub.mybodytech.co/api/rips/external-rips
MYBODYTECH_RIPS_CLIENT_ID=
MYBODYTECH_RIPS_CLIENT_SECRET=
MYBODYTECH_RIPS_BRAND=1
MYBODYTECH_RIPS_ORG=1

# Resend (reset de contraseña por email)
RESEND_API_KEY=re_...
RESEND_FROM=Bodytech <no-reply@tudominio.com>

# ---------------------------------------------------------------------------
# Llamada del coach al paciente (en vivo, grabada) — ver CLAUDE.md
# Twilio marca al celular del coach (usuarios.celular) y después al paciente.
# ---------------------------------------------------------------------------
TWILIO_VOICE_ACCOUNT_SID=                 # opcional (subcuenta de voz); default TWILIO_ACCOUNT_SID
TWILIO_VOICE_AUTH_TOKEN=                  # opcional; default TWILIO_AUTH_TOKEN
TWILIO_VOICE_FROM=+576016284820           # número saliente

# ---------------------------------------------------------------------------
# WhatsApp automáticos del día — ver CLAUDE.md. Apagados por defecto.
# ---------------------------------------------------------------------------
RECORDATORIO_ENABLED=false                # 07:00: hora + Reprogramar, SIN link
RECORDATORIO_HORA=07:00
RECORDATORIO_HORA_FIN=19:00
TWILIO_WHATSAPP_RECORDATORIO_TEMPLATE_SID=HX870a0caca39c10f10446f005373ec92f
LINK_AUTO_ENABLED=false                   # link minutos antes de cada cita
LINK_AUTO_MINUTOS_ANTES=15
LINK_AUTO_GRACIA_MIN=5
LINK_AUTO_INTERVALO_MIN=5
LINK_AUTO_SOLO_CELULARES=                 # lista blanca CSV para probar
LINK_AUTO_SEDES=                          # rollout por sede
